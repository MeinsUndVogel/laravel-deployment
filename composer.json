{
    "name": "muv/laravel-deployment",
    "description": "Automatische Deployments mit GitHub",
    "keywords": [
        "muv",
        "php",
        "deployment"
    ],
    "homepage": "https://github.com/MeinsUndVogel/laravel-deployment",
    "license": "MIT",
    "authors": [
        {
            "name": "Oliver Vogel",
            "email": "o.vogel@muv.com",
            "role": "Developer"
        },
        {
            "name": "Jonas Barth",
            "email": "j.barth@muv.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29.0",
        "pestphp/pest": "^4.6.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "phpstan/phpstan": "^2.1.50"
    },
    "autoload": {
        "psr-4": {
            "MUV\\LaravelDeployment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint --parallel",
        "test:lint": "pint --parallel --test",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:types": "phpstan",
        "test:unit": "pest --parallel",
        "test": [
            "@test:lint",
            "@test:type-coverage",
            "@test:types",
            "@test:unit"
        ]
    }
}
