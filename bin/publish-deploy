#!/usr/bin/env php
<?php

declare(strict_types=1);

$projectRoot = getcwd();
$source = dirname(__DIR__).'/stubs/deploy.php';
$destinationDir = $projectRoot.'/public';
$destination = $destinationDir.'/deploy.php';

if (! is_dir($destinationDir)) {
    mkdir($destinationDir, 0755, true);
}

if (file_exists($destination)) {
    echo 'Error: Target file already exists'.PHP_EOL;
    exit(1);
}

if (! copy($source, $destination)) {
    echo 'Error: Failed to copy deploy.php'.PHP_EOL;
    exit(1);
}

$mdSource = dirname(__DIR__).'/deployment.md';
$mdDestination = $projectRoot.'/deployment.md';

if (file_exists($mdDestination)) {
    echo 'Warning: deployment.md already exists, skipping'.PHP_EOL;
} elseif (! copy($mdSource, $mdDestination)) {
    echo 'Error: Failed to copy deployment.md'.PHP_EOL;
    exit(1);
}

echo 'Files successfully published'.PHP_EOL;
